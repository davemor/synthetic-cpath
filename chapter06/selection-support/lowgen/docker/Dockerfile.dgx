ARG RAPIDS_IMAGE=rapidsai/base:26.06-cuda12-py3.12
FROM ${RAPIDS_IMAGE}

USER root

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    RAPIDS_NO_INITIALIZE=1 \
    CUPY_CACHE_DIR=/workspace/lowgen/.cupy \
    TMPDIR=/workspace/lowgen/.tmp

WORKDIR /workspace/lowgen

RUN mkdir -p /workspace/lowgen/.cupy /workspace/lowgen/.tmp

RUN python -m pip install --no-cache-dir --upgrade pip uv

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY config ./config
COPY scripts ./scripts

RUN uv sync --frozen --no-dev

ENV PATH="/workspace/lowgen/.venv/bin:${PATH}" \
    PYTHONPATH="/workspace/lowgen/src"

RUN python -c "import cupy, cuml, dask_cuda, dask_cudf"

ENTRYPOINT ["lowgen"]
