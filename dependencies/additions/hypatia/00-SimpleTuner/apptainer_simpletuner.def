Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

%post
    # Update package list
    apt-get update -y
    
    # Prevent interactive prompts
    export DEBIAN_FRONTEND=noninteractive
    
    # Install dependencies
    apt-get install -y libgl1-mesa-glx ffmpeg libsm6 libxext6 \
                       openssh-server openssh-client git git-lfs wget curl \
                       tmux tldr nvtop vim rsync net-tools less iputils-ping \
                       p7zip-full zip unzip htop inotify-tools python3.10-venv

    # Configure git
    git config --global credential.helper store
    git lfs install
    
    # Install Python and dependencies
    apt-get install -y python3 python3-pip
    python3 -m pip install --upgrade pip
    
    # Hugging Face CLI
    pip3 install "huggingface_hub[cli]"
    
    # Install WanDB
    pip3 install wandb
    
    # Clone SimpleTuner
    git clone https://github.com/bghira/SimpleTuner --branch release /home/dm236/repos/SimpleTuner
    
    # Install Poetry and set up SimpleTuner
    pip3 install poetry
    cd /home/dm236/repos/SimpleTuner && python3 -m venv .venv && poetry install --no-root
    chmod +x /home/dm236/repos/SimpleTuner/train.sh

%environment
    export HF_HOME=/home/dm236/repos/huggingface

%startscript
    exec /start.sh

%files
    docker-start.sh /start.sh

%runscript
    exec /start.sh

