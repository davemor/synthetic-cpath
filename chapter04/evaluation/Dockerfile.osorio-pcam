FROM pytorch/pytorch:1.13.1-cuda11.6-cudnn8-runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Reconstruct the software generation reported by Osorio et al. PyTorch is
# exact; the remaining versions pin the contemporary Diffusers 0.15.1 stack.
RUN pip install --upgrade pip==23.1.2 setuptools==67.7.2 wheel==0.40.0

RUN pip install \
    accelerate==0.17.1 \
    datasets==2.11.0 \
    diffusers==0.15.1 \
    fsspec==2023.4.0 \
    huggingface-hub==0.13.4 \
    numpy==1.24.2 \
    pandas==1.5.3 \
    pyarrow==11.0.0 \
    pillow==9.5.0 \
    tensorboard==2.12.1 \
    transformers==4.28.1 \
    xformers==0.0.16

RUN mkdir -p /opt/osorio/diffusers && \
    curl -L --fail \
      https://raw.githubusercontent.com/huggingface/diffusers/v0.15.1/examples/text_to_image/train_text_to_image.py \
      -o /opt/osorio/diffusers/train_text_to_image.py

WORKDIR /workspace/synpath
